# Clave de API de Google Gemini (Opcional para escaneo con Visión Multimodal)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Puerto del servidor backend (por defecto 3001)
PORT=3001

# Google AdSense (Opcional: ID de bloque de anuncios / Ad Slot ID si usas bloques manuales además de Auto Ads)
VITE_ADSENSE_SLOT_ID=
